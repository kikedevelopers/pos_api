# =============================================================================
# POS API - Variables de entorno para DESPLIEGUE (production/staging).
#
# Copia este archivo a `.env` en la VM y ajusta valores (especialmente
# JWT_SECRET, contraseñas, DOMAIN, LETSENCRYPT_EMAIL y CORS_ORIGINS).
# NO comitear el `.env` real.
#
# Lo usan tanto `docker-compose.yml` (build local) como
# `docker-compose.prod.yml` (full stack desde registry + nginx + certbot).
# =============================================================================

# ---------- Deploy (registry + dominio + TLS) ----------
# Imagen Docker a desplegar. La pone el workflow CI/CD en GHCR.
# Sustituye <owner>/<repo> por los reales (lower-case).
IMAGE_NAME=ghcr.io/CHANGEME/pos_api:latest

# Dominio público del API (sin protocolo). Apunta tu DNS A-record a la IP
# de la VM ANTES de correr `./deploy.sh` la primera vez.
DOMAIN=foxpos.kikedevs.com

# ---------- Frontend PWA (servido por el MISMO edge nginx) ----------
# Dominio público de la PWA. El edge nginx la sirve aquí (reverse proxy al
# contenedor `pwa`). Apunta también su A-record a la IP de la VM. Si lo dejas
# vacío, el stack corre solo el API (sin PWA).
PWA_DOMAIN=erp.kikedevs.com
# Imagen de la PWA en GHCR (la publica el repo placepos_pwa_app). Lower-case.
PWA_IMAGE_NAME=ghcr.io/CHANGEME/placepos_pwa_app:latest

# ---------- Releases de PlacePos (servidos por el MISMO edge nginx) ----------
# Dominio público donde se descargan los instalables (.exe/.dmg) y desde donde
# electron-updater de los clientes Windows lee latest.yml. El action de placepos
# sube los archivos por SCP a ./releases (host) y nginx los sirve como estáticos.
# Apunta su A-record a la IP de la VM. Si lo dejas vacío, no se publica ni se
# emite su certificado.
RELEASES_DOMAIN=releases.kikedevs.com

# Email para Let's Encrypt (avisos de expiración / renovación fallida).
LETSENCRYPT_EMAIL=kikedevelopers@gmail.com

# 1 = usa el servidor de pruebas de Let's Encrypt (sin rate limit duro,
# pero el cert NO es de confianza). Útil para validar el setup la primera
# vez antes de pedir el cert real. Cambiar a 0 para producción.
LETSENCRYPT_STAGING=0

# ---------- Aplicación ----------
NODE_ENV=production
PORT=3010
API_PREFIX=
LOG_LEVEL=info

# ---------- Base de datos ----------
# DB_HOST se fuerza a "postgres" en compose (red interna). No definir aquí.
DB_USERNAME=pos_user
# Generar una contraseña fuerte:
#   openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=pos_db
DB_LOGGING=false

# ---------- Migraciones automáticas al arrancar ----------
# true  = entrypoint corre `migration:run` antes de iniciar la API (default).
# false = saltar (corres `docker compose exec api ...` a mano).
RUN_MIGRATIONS=true

# ---------- Throttling ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------- Trust proxy ----------
# 1 = la API está detrás de un único reverse proxy (Nginx/Caddy/Cloudflare).
# 0 = expuesta directamente (no recomendado en producción).
TRUST_PROXY=1

# ---------- Swagger ----------
# Apagado en producción salvo que necesites el explorador público de la API.
SWAGGER_ENABLED=false

# ---------- CORS ----------
# Lista separada por coma. NO uses "*" en producción. DEBE incluir el dominio
# de la PWA para que el navegador pueda llamar al API desde ella.
CORS_ORIGINS=https://erp.kikedevs.com

# ---------- JWT ----------
# OBLIGATORIO cambiarlo. Generar:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Joi rechaza arrancar en production si detecta el secret de desarrollo.
JWT_SECRET=CHANGE_ME_long_random_secret_min_64_chars
JWT_EXPIRES_OWNER=7d
JWT_EXPIRES_EMPLOYEE=1d

# ---------- Firmas asimétricas Ed25519 (paneles externos: kdevs-admin) ----------
# Clave PÚBLICA (SPKI en base64). La privada vive en el cliente, nunca aquí.
# Vacío = endpoints firmados deshabilitados (devuelven 503 "no habilitado").
#
# migration-import (Generar ZIP desde kdevs). Su privada: POSAPI_SIGNING_PRIVATE_KEY en kdevs.
ADMIN_SIGNING_PUBLIC_KEY=
ADMIN_SIGNATURE_MAX_SKEW_MS=300000
#
# Módulo SUPERADMIN (Cuentas en kdevs). Su privada se carga SOLO en el navegador.
# Debe ser el MISMO par que en dev para que la clave cargada funcione en ambos.
SUPERADMIN_SIGNING_PUBLIC_KEY=
SUPERADMIN_SIGNATURE_MAX_SKEW_MS=120000
