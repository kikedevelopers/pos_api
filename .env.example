# =========================================================
# POS API - Variables de Entorno (ejemplo)
# Copia este archivo a `.env` y ajusta los valores.
# =========================================================

# ---------- Aplicación ----------
# Entorno de ejecución: development | test | staging | production
NODE_ENV=development

# Puerto HTTP en el que escucha la API
# 3010 evita choque con otros servicios que típicamente usan 3000 en dev.
PORT=3010

# Prefijo global de la API. Por defecto vacío — el cliente PlacePos consume el
# API en raíz (/sales, /auth/user, ...). Solo define un prefix si tu reverse
# proxy lo requiere (ej: API_PREFIX=api/v1 para servir en /api/v1/...).
API_PREFIX=

# Nivel de logging (pino): fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------- Base de datos (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pos_user
DB_PASSWORD=pos_password
DB_NAME=pos_db

# IMPORTANTE: mantener `false` en producción. Usar migraciones siempre.
DB_SYNCHRONIZE=false

# Logging SQL: true | false | "query,error" etc.
DB_LOGGING=false

# SSL para conexiones gestionadas (RDS, Supabase, etc.)
DB_SSL=false

# ---------- Throttling / Rate limit ----------
# TTL en milisegundos para la ventana del rate limit
THROTTLE_TTL=60000

# Máximo de peticiones permitidas por ventana TTL
THROTTLE_LIMIT=100

# ---------- Trust proxy ----------
# Cantidad de "hops" de proxy/LB delante del API. El throttler usa req.ip,
# así que sin esto todos los clientes detrás de un LB comparten cubo.
#   0       = directo (sin proxy)
#   1       = tras 1 proxy/LB (lo más común en cloud)
#   N       = N proxies encadenados
#   true    = confía en TODOS (peligroso, solo si sabes lo que haces)
#   loopback / linklocal / uniquelocal = keywords de Express
TRUST_PROXY=0

# ---------- Swagger / OpenAPI ----------
SWAGGER_ENABLED=true

# ---------- CORS ----------
# Lista de orígenes permitidos separados por coma. Usa "*" para todos (NO recomendado en producción)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- JWT / Auth ----------
# IMPORTANTE: en producción usa un valor largo y aleatorio (>= 64 caracteres).
# El placeholder de abajo está explícitamente rechazado por Joi cuando
# NODE_ENV=production para evitar deploys descuidados con secret conocido.
# Generar uno fuerte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_OWNER=7d
JWT_EXPIRES_EMPLOYEE=1d

# ---------- Firma admin (paneles externos: kdevs-admin) ----------
# Clave pública Ed25519 (SPKI en base64) para verificar los endpoints /admin/*
# firmados. La clave privada correspondiente vive en el panel. Vacío =
# endpoints firmados deshabilitados. Generar un par:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log('PUB',publicKey.export({format:'der',type:'spki'}).toString('base64'));console.log('PRIV',privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
ADMIN_SIGNING_PUBLIC_KEY=
ADMIN_SIGNATURE_MAX_SKEW_MS=300000

# ---------- Firma superadmin (panel kdevs-admin) ----------
# PAR DEDICADO, DISTINTO al de ADMIN_SIGNING_PUBLIC_KEY. Clave pública Ed25519
# (SPKI en base64) que verifica los endpoints /superadmin/*. La clave PRIVADA
# correspondiente vive SOLO en el navegador del panel superadmin (kdevs-admin)
# y nunca toca el servidor. Vacío = endpoints /superadmin/* deshabilitados (503).
# Comparte la ventana anti-replay ADMIN_SIGNATURE_MAX_SKEW_MS. Generar un par
# con el mismo snippet de arriba.
SUPERADMIN_SIGNING_PUBLIC_KEY=

# ---------- Respaldos de la BD → Google Cloud Storage ----------
# Módulo /backups/* (panel kdevs-admin), protegido con la MISMA firma Ed25519
# que /superadmin/*. Sin GCS_BACKUP_BUCKET el módulo queda deshabilitado: el
# listado responde `configured: false` y generar un respaldo da 503.
GCS_BACKUP_BUCKET=
# Carpeta dentro del bucket (por defecto "backups").
GCS_BACKUP_PREFIX=backups
# Credenciales de la service account con permiso sobre el bucket. Se admite el
# JSON completo en una línea (GCS_CREDENTIALS_JSON) o la ruta a un archivo
# (GCS_CREDENTIALS_FILE). Si ambas están vacías se usan las credenciales por
# defecto del entorno (ADC), útil solo si la VM corre en Google con identidad.
GCS_CREDENTIALS_JSON=
GCS_CREDENTIALS_FILE=
# Normalmente ya viene dentro del JSON de la service account.
GCS_PROJECT_ID=
# Corta un pg_dump colgado (ms). 10 minutos por defecto.
BACKUP_TIMEOUT_MS=600000
# Ruta del binario pg_dump. Vacío = se busca en el PATH (así es en el contenedor,
# que ya trae postgresql18-client). En macOS con Homebrew hace falta apuntarlo:
# PG_DUMP_BIN=/opt/homebrew/opt/libpq/bin/pg_dump
PG_DUMP_BIN=

# Respaldo automático diario a medianoche (hora Colombia). 'false' lo desactiva
# (útil en local para no generar respaldos mientras se desarrolla).
BACKUP_CRON_ENABLED=true
# De dónde salen las credenciales de GCS:
#   auto (por defecto) → en producción usa la identidad de la VM (ADC) y en
#                        local el archivo/JSON de abajo.
#   adc | file | json  → fuerza un origen concreto.
GCS_CREDENTIALS_MODE=auto
